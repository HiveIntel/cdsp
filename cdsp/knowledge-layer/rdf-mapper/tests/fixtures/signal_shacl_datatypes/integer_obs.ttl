@prefix cdsp: <http://covesa.org/cdsp_kl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix vss: <https://covesa.org/vss/latest/model#> .
@prefix vsssh: <https://covesa.org/vss/latest/shapes#> .

cdsp:StateOfChargeCurrentShape a sh:NodeShape ;
    vss:path "Vehicle.Powertrain.TractionBattery.StateOfCharge.Current" ;
    sh:targetClass sosa:Observation ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:node vsssh:Vehicle_Powertrain_TractionBattery_StateOfCharge ;
    ] ;
    sh:property [
        vss:value "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:unsignedByte ;
    ] ;
    sh:property [
        vss:value "timestamp" ;
        sh:path sosa:resultTime ;
        sh:datatype xsd:dateTime ;
    ] .

cdsp:IntSignalShape a sh:NodeShape ;
    vss:path "Vehicle.Test.Int" ;
    sh:targetClass sosa:Observation ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:node vsssh:Vehicle ;
    ] ;
    sh:property [
        vss:value "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:int ;
    ] ;
    sh:property [
        vss:value "timestamp" ;
        sh:path sosa:resultTime ;
        sh:datatype xsd:dateTime ;
    ] .


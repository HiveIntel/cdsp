cdsp:UnsignedLongSignalShape a sh:NodeShape ;
    vss:path "Vehicle.Test.UnsignedLong" ;
    sh:targetClass sosa:Observation ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;

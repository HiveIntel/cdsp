@prefix car: <http://example.ontology.com/car#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix val: <http://example.ontology.com/validation#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

val:VehicleShape a sh:NodeShape ;
    sh:name "id" ;
    sh:class car:Vehicle ;
    val:iriPrefix "car:Vehicle" ;
    sh:property [
        sh:path car:hasPart ;
        sh:node val:ChassisShape ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path car:hasSignal ;
        sh:node val:CurrentLocationShape ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

val:ChassisShape a sh:NodeShape ;
    sh:name "id" ;
    sh:class car:Chassis ;
    val:iriPrefix "car:Chassis" ;
    sh:property [
        sh:path car:hasPart ;
        sh:node val:SteeringWheelShape ;
        sh:nodeKind sh:IRI ;
        sh:minCount 1 ;
    ] .

val:SteeringWheelShape a sh:NodeShape ;
    sh:name "id" ;
    sh:class car:SteeringWheel ;
    val:iriPrefix "car:SteeringWheel" .

val:CurrentLocationShape a sh:NodeShape ;
    sh:name "id" ;
    sh:class car:CurrentLocation ;
    val:iriPrefix "car:CurrentLocation" .

val:VehicleChassisSteeringWheelAngleObservationShape a sh:NodeShape ;
    sh:name "vehicle.chassis.steeringwheel.angle" ;
    sh:targetClass sosa:Observation ;
    val:iriPrefix "car:ob_angle_" ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:node val:SteeringWheelShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:int ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "constant" ;
        sh:path sosa:observedProperty ;
        sh:hasValue car:angle ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "timestamp" ;
        sh:path sosa:phenomenonTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

val:VehicleCurrentLocationLatitudeObservationShape a sh:NodeShape ;
    sh:name "vehicle.currentlocation.latitude" ;
    sh:targetClass sosa:Observation ;
    val:iriPrefix "car:ob_latitude_" ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:node val:CurrentLocationShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "constant" ;
        sh:path sosa:observedProperty ;
        sh:hasValue car:latitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:double ;
        sh:minInclusive -90 ;
        sh:maxInclusive 90 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "timestamp" ;
        sh:path sosa:phenomenonTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

val:VehicleCurrentLocationLongitudeObservationShape a sh:NodeShape ;
    sh:name "vehicle.currentlocation.longitude" ;
    sh:targetClass sosa:Observation ;
    val:iriPrefix "car:ob_longitude_" ;
    sh:property [
        sh:path sosa:hasFeatureOfInterest ;
        sh:node val:CurrentLocationShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "constant" ;
        sh:path sosa:observedProperty ;
        sh:hasValue car:longitude ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:double ;
        sh:minInclusive -180 ;
        sh:maxInclusive 180 ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "timestamp" ;
        sh:path sosa:phenomenonTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .

val:VehicleSpeedObservationShape a sh:NodeShape ;
    sh:name "vehicle.speed" ;
    sh:targetClass sosa:Observation ;
    val:iriPrefix "car:ob_speed_" ;
    sh:property [
        sh:name "id" ;
        sh:path sosa:hasFeatureOfInterest ;
        sh:node val:VehicleShape ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "constant" ;
        sh:path sosa:observedProperty ;
        sh:hasValue car:speed ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "value" ;
        sh:path sosa:hasSimpleResult ;
        sh:datatype xsd:float ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:name "timestamp" ;
        sh:path sosa:phenomenonTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
